__lua__
--parryalter
--by qurredev クレ-

function _init()
	state = "menu"
	menu_init()	
end

function _update60()
	if state=="menu" then menu_update()
	elseif state=="play" then play_update()
	elseif state=="over" then over_update()
	end
end

function _draw()
	if state=="menu" then menu_draw()
	elseif state=="play" then play_draw()
	elseif state=="over" then over_draw()
	end
end
-->8
--menu

function menu_init()
	menu_sel=1
	menu_items ={"start","how to play"}

end

function menu_update()
	

	if btnp(2) then menu_sel = max(1,menu_sel-1) end
	if btnp(3) then menu_sel = min(#menu_items,menu_sel+1) end
	
	if btnp(4) or btnp(5) then -- (z or x)
		if menu_sel==1 then
			play_init()
			state="play"
		end
	end

end


function menu_draw()
	cls(0)
		
	print("pARRYaLTER",42,30,10)
	for i,item in ipairs(menu_items) do
		local col = i==menu_sel and 7 or 5
		local txt = (i==menu_sel and ">" or " ")
		print(txt,40,60+i*10,col)
	end
end
-->8
--game

--config
bpm = 120
spd = 15
beat_time = spd*4*183/22050
approach_beats = 4

perfect_window=0.1
hit_window = 0.25

audio_offset = 0.02

judge = {text="", col=7,timer=0}

-- 0 is from below, 1 from right, 2 from above, 3 from left
-- ox, oy, spawn pos | tx ty pos where sword touches player
-- s,w,h = sprite, width, height in tiles \ btn that parries
dirs = {
	[0]= {ox=60,oy=128,tx=60,ty=72,s=3,w=1,h=1, btn=3},
	[1]= {ox=128,oy=60,tx=72,ty=60,s=35,w=1,h=1, btn=1},
	[2]= {ox=60,oy=-8,tx=60,ty=48,s=19,w=1,h=1, btn=2},
	[3]= {ox=-8,oy=60,tx=48,ty=60,s=51,w=1,h=1, btn=0},
}

slash_len = 0.4

slash_fx = {
	[0] = {frames={64, 80,96}, w=2,h=1, ox=-4,oy=0},
	[1] = {frames={100, 101,102}, w=1,h=2, ox=0,oy=-4},
	[2] = {frames={66, 82,98}, w=2,h=1, ox=-4,oy=2},
	[3] = {frames={68, 69,70}, w=1,h=2, ox=2,oy=-4},
}


function play_init()
	music(2)
	start_time = time()
	current_beat = 0
	swords = {}
	next_note = 1
	health = 6
	score = 0
	debug =false
	
	
	
	player_s_dir=1
	
	slash_start = {}
	
	--chart
	charts = {
		
		}
	for i=4,64 do add(charts,{beat=i,dir=i%4}) end	
		--[[
		{beat=4,dir=2},
		{beat=8,dir=1},
		{beat=12,dir=0},
		{beat=16,dir=3},
		{beat=20,dir=0},
		{beat=24,dir=1},
		{beat=28,dir=2},
		{beat=32,dir=3},
		]]
	--start song
end

function play_update()
	current_beat = (time()-start_time-audio_offset)/beat_time
	
	spawn_notes()
	handle_input()
	
	for s in all(swords) do
		--sword reached the player without being parried
		if current_beat >= s.hit_beat then
		 del(swords,s)
		 health -=1
		 show_judge("miss",8)
		end
	end
	if judge.timer>0 then judge.timer -= 1 end
	
	--add gameover state
end

function play_draw()
 cls(0)
 map(0,0,0,0,16,16)
 print(stat(1),60,10)
 print(current_beat,60,20)
 draw_arena()
 draw_player()
 
 if debug then draw_debug() end
	
	draw_slashes()
	
 --sword
 for s in all(swords) do
 	local t = sword_t(s)
 	spr(s.d.s, rnd_px(pos_x(s.d,t)), rnd_px(pos_y(s.d,t)), s.d.w, s.d.h)
 end
 
 print("hp:"..health.."  score:"..score,2,2,7)
	if judge.timer>0 then
		print(judge.text,2,10,judge.col)
	end
end

function draw_player()
	if player_s_dir==0 then
		spr(36,56,56,2,2)	-- player
	elseif player_s_dir==1 then
		spr(4,56,56,2,2)	-- player
	elseif player_s_dir==2 then
		spr(38,56,56,2,2)	-- player
	else
		spr(6,56,56,2,2)	-- player
	end
end

--sword making
-- 0 1 2 3
-- ⬆️⬅️⬇️➡️

function new_sword(dir,parry_beat)
	return {
		dir = dir,
		d = dirs[dir],
		parry_beat = parry_beat,
		start_beat = parry_beat - approach_beats,
		hit_beat=parry_beat+1
	}
end

function lerp(a,b,t)
	return a+(b-a)*t
end
function rnd_px(v) return flr(v+0.5) end

--t=0 atspawn, t=1 touching player
function pos_x(d,t) return lerp(d.ox,d.tx,t) end
function pos_y(d,t) return lerp(d.oy,d.ty,t) end

function sword_t(s)
		return(current_beat-s.start_beat)/(approach_beats+1)
	end

function spawn_notes()
	local c = charts[next_note]
	while c and current_beat >= c.beat-approach_beats do
		add(swords, new_sword(c.dir, c.beat))
		next_note +=1
		c = charts[next_note]
	end
end

--parry
function handle_input()
	for dir=0,3 do
		if btnp(dirs[dir].btn) then
			player_s_dir = dir
			slash_start[dir] = current_beat
			try_parry(dir)
		end
	end
end

function try_parry(dir)
	for s in all(swords) do
		local diff = abs(current_beat-s.parry_beat)
		if s.dir==dir and diff<=hit_window then
			del(swords,s)
		
			if diff<= perfect_window then
				score+=2
				show_judge("perfect",10)
			else
				score+= 1
				if current_beat < s.parry_beat then
					show_judge("good (early)",12)
				else
					show_judge("good (late)",9)
				end
				
			end
			return true
		end
	end
	return false
end

function show_judge(text, col)
	judge.text=text
	judge.col=col
	judge.timer=30
end

function draw_slashes()
	local tp = approach_beats/(approach_beats+1)
	for dir=0,3 do
		local st = slash_start[dir]
		if st then
			local t = (current_beat-st)/slash_len
			if t >= 1 then
				slash_start[dir] = nil
			else
				local f = slash_fx[dir]
				local d = dirs[dir]
				local frame = flr(t*#f.frames)+1
						
				spr(f.frames[frame],pos_x(d,tp)+f.ox,pos_y(d,tp)+f.oy,f.w,f.h)
			end
		end
	end
end

function draw_arena()
	-- ring brightens briefly on each beat
	local col = (current_beat%1 < 0.3) and 6 or 5
	oval(44,44,83,83,col)

	-- markers at the perfect point of each lane
	line(60,83,67,83,10)   -- below
	line(60,44,67,44,10)   -- above
	line(83,60,83,67,10)   -- right
	line(44,60,44,67,10 )   -- left
end





--green perfect, grey window edges
function draw_debug()
	local tp = approach_beats/(approach_beats+1)
	local tw = hit_window/(approach_beats+1)
	for dir=0,3 do
		local d = dirs[dir]
		local w,h = d.w*8-1, d.h*8-1
		for t in all({tp-tw,tp+tw}) do
			local x,y = rnd_px(pos_x(d,t)), rnd_px(pos_y(d,t))
			rect(x,y,x+w,y+h,5)
		end
		local x,y = rnd_px(pos_x(d,tp)), rnd_px(pos_y(d,tp))
		rect(x,y,x+w,y+h,11)
	end
end


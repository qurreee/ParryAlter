pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
--bpm 
bpm = 120
beat_time = 60/bpm
approach_beats = 4
--beat = elapsed_time/beat_time


function _init()
	cls(0)
	
	current_beat = 0
	
	swords = {}
	charts = {
		{beat=4,dir=0,spawned=false},
		{beat=8,dir=1,spawned=false},
		{beat=10,dir=2,spawned=false},
		{beat=14,dir=3,spawned=false},
		}
end

function _draw()
 cls(0)

 --sword
 for s in all(swords) do
 	s:draw()
 end
 
 -- player
 spr(4,56,56,2,2)
end

function _update()
	current_beat = time()/beat_time
	
	update_chart()
	
	for s in all(swords) do
		s:update()
	end
end

--sword making
-- 0 1 2 3
-- ⬆️⬅️⬇️➡️

function create_sword(dir,hit_beat)
	local s = {
		x=0,
		y=0,
		dir = dir,
		origin = {x=0,y=0},
		target = {x=0,y=0},
		hit_beat = hit_beat,
		start_beat = 0,
		active = true
	}
	
	function s:get_origin_pos()
		if self.dir==0 then
		 self.target = {x=60,y=56}
		 return {x=60,y=120}
		elseif self.dir==1 then
			self.target = {x=56,y=60}
			return {x=120,y=60}
		elseif self.dir==2 then
			self.target = {x=60,y=56}
			return {x=60,y=8}
		else 
			self.target = {x=56,y=60}
			return {x=8,y=60}
		end
	end 
	
	
	function s:get_start_beat()
		return  self.hit_beat-approach_beats
	end
	
	function s:update()
	 local progress = (current_beat-self.start_beat)/approach_beats
	 progress = mid(0,progress,1)
	 
		self.x = lerp(self.origin.x, self.target.x,progress)
		self.y = lerp(self.origin.y, self.target.y,progress)
	end
	
	function s:draw()
		if current_beat<self.start_beat then
	 	return
	 end
	 
	 if self.dir==0 then
		 spr(1,self.x,self.y,1,2)
		elseif self.dir==1 then
			spr(33,self.x,self.y,2,1)
		elseif self.dir==2 then
			spr(2,self.x,self.y,1,2)
		else 
			spr(49,self.x,self.y,2,1)
		end
	 
	end
	
	s.origin = s:get_origin_pos()
	s.x = s.origin.x
	s.y = s.origin.y
	s.start_beat = s:get_start_beat()
	
	return s
end

function lerp(a,b,t)
	return a+(b-a)*t
end

function update_chart()
	for c in all(charts) do
		local start_beat = c.beat - approach_beats
		
		if current_beat >= start_beat and not c.spawned then
			add(swords, create_sword(c.dir, c.beat))
			c.spawned=true
		end
	end
end
	
